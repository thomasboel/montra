+import { CommandUnknownOpts } from '@commander-js/extra-typings';
+
+export function extractCommandStructure(command: CommandUnknownOpts): any {
+  return {
+    name: command.name(),
+    description: command.description(),
+    arguments: command.registeredArguments,
+    options: command.options,
+    subcommands: command.commands.map((subcommand) =>
+      extractCommandStructure(subcommand),
+    ),
+  };
+}
