+import { Argument, Option } from '@commander-js/extra-typings';
+
+interface CommandStructure {
+  name: string;
+  description: string;
+  arguments: Argument[];
+  options: Option[];
+  subcommands: CommandStructure[];
+}
+
+export function generateMarkdownFromCommandStructure(
+  command: CommandStructure,
+  level = 1,
+): string {
+  const indent = '#'.repeat(level);
+  let markdown = `${indent} ${command.name}\n\n`;
+
+  if (command.description) {
+    markdown += `${command.description}\n\n`;
+  }
+
+  if (command.arguments.length > 0) {
+    markdown += `### Arguments\n\n`;
+    command.arguments.forEach((arg, index) => {
+      markdown += `- **Argument ${index + 1}**: ${
+        arg.required ? 'Required' : 'Optional'
+      }${arg.variadic ? ', Variadic' : ''}\n`;
+    });
+    markdown += `\n`;
+  }
+
+  if (command.options.length > 0) {
+    markdown += `### Options\n\n`;
+    command.options.forEach((option) => {
+      markdown += `- **${option.flags}**: ${option.description} ${
+        option.required ? '(Required)' : ''
+      }\n`;
+    });
+    markdown += `\n`;
+  }
+
+  if (command.subcommands.length > 0) {
+    markdown += `### Subcommands\n\n`;
+    command.subcommands.forEach((subcommand) => {
+      markdown += generateMarkdownFromCommandStructure(subcommand, level + 1);
+    });
+  }
+
+  return markdown;
+}
